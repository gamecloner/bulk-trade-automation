# ============================================
# BULK TRADE BOT - Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Wallet ---
# Your Solana private key (base58 encoded) - TESTNET ONLY
SOLANA_PRIVATE_KEY=
# Leave empty to auto-generate a new keypair
AUTO_GENERATE_WALLET=true

# --- Platform ---
PLATFORM_URL=https://early.bulk.trade
TESTNET=true

# --- RPC ---
SOLANA_RPC_URL=https://api.devnet.solana.com
# For better performance, use a dedicated RPC:
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# --- Execution Mode ---
# "sdk" = Direct API/SDK (fast, preferred)
# "browser" = Playwright stealth browser automation (fallback)
# "auto" = Try SDK first, fallback to browser
EXECUTION_MODE=auto

# --- Trading ---
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=20
MAX_POSITION_SIZE_USD=1000
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=5.0
MAX_DRAWDOWN_PCT=10.0

# --- Markets ---
# Comma-separated: BTC/USD,ETH/USD,SOL/USD
TRADING_PAIRS=SOL/USD,BTC/USD,ETH/USD

# --- Scalping ---
SCALP_PROFIT_TARGET_PCT=0.15
SCALP_STOP_LOSS_PCT=0.10
SCALP_COOLDOWN_SECONDS=5
SCALP_EMA_FAST=9
SCALP_EMA_SLOW=21

# --- Arbitrage ---
ARB_MIN_SPREAD_PCT=0.08
ARB_EXECUTION_WINDOW_MS=2000
ARB_SLIPPAGE_TOLERANCE_PCT=0.05

# --- External Price Feeds (for arbitrage) ---
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
PYTH_PRICE_FEED=true

# --- Browser Automation ---
HEADLESS=true
BROWSER_PROXY=
# Anthropic-style delays for human simulation
MIN_ACTION_DELAY_MS=200
MAX_ACTION_DELAY_MS=800

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
TRADE_LOG_FILE=logs/trades.csv
